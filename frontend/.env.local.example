# Next.js Environment Variables - Example Configuration
# Copy this file to .env.local and configure for your environment

# ── Backend URL (server-side) ──────────────────────────────
# Single backend URL used by all BFF routes
BACKEND_URL=http://localhost:3000

# ─── Auth / JWT ───────────────────────────────────────────
# Must match the secret used by backend to sign tokens
JWT_SECRET=your-jwt-secret-change-in-production

# ─── Frontend Public Variables (exposed to browser) ─────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VeriBuy
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# ─── Internal Service URL Aliases (server-side only) ────────
# All point to the single backend. Override for production deploys.
AUTH_SERVICE_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3000
LISTING_SERVICE_URL=http://localhost:3000
TRUST_LENS_SERVICE_URL=http://localhost:3000
EVIDENCE_SERVICE_URL=http://localhost:3000
TRANSACTION_SERVICE_URL=http://localhost:3000
NOTIFICATION_SERVICE_URL=http://localhost:3000
