# Database
POSTGRES_USER=veribuy
POSTGRES_PASSWORD=veribuy_dev_password
POSTGRES_DB=veribuy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://veribuy:veribuy_dev_password@localhost:5432/veribuy
# Optional per-instance pool size and query timeout (defaults shown)
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=veribuy_redis_dev
REDIS_TLS=false

# Backend
PORT=3000
BACKEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3010
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRATION=7d
# Shared secret for internal module-to-module calls (x-internal-service header).
# Must be at least 32 characters in production.
INTERNAL_SERVICE_TOKEN=replace-with-an-internal-secret

# One-time token that authorises the /auth/admin/bootstrap endpoint.
# The endpoint self-disables once the first admin account exists.
ADMIN_SETUP_TOKEN=

# Development convenience flags — MUST remain unset/false in production.
# Boot-time validation rejects AUTO_VERIFY_EMAIL=true when NODE_ENV=production.
AUTO_VERIFY_EMAIL=false

# Dev-only: accept the static phone OTP 123456 and echo real OTPs in API responses.
# Boot-time validation rejects ALLOW_DEV_OTP_BYPASS=true when NODE_ENV=production.
ALLOW_DEV_OTP_BYPASS=false

# Social sign-in: comma-separated OAuth client IDs accepted as the ID token audience.
# Include the web client ID plus the iOS/Android (Expo) client IDs. Leave empty to disable.
GOOGLE_CLIENT_IDS=
# Apple: Services ID (web) and app bundle ID (iOS).
APPLE_CLIENT_IDS=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VeriBuy
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Marketplace rules (all required; web and mobile read them from the backend)
BUYER_PROTECTION_FEE_PERCENT=5
CHECKOUT_HOLD_MINUTES=45
AUCTION_PAYMENT_WINDOW_HOURS=48
OFFER_PAYMENT_WINDOW_HOURS=48
POSTING_OVERDUE_DAYS=4
CHARITY_DONATION_GBP=1
CLEARPAY_MAX_GBP=1200
CANCELLED_ORDER_RETENTION_DAYS=30
ABANDONED_LISTING_RETENTION_DAYS=30
# VeriBuy's handling charge per parcel, added to the Royal Mail rate
SHIPPING_HANDLING_FEE_SMALL_GBP=1.50
SHIPPING_HANDLING_FEE_MEDIUM_GBP=2

# Payments
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook at <frontend>/api/webhooks/stripe. Set it on the frontend only.
STRIPE_WEBHOOK_SECRET=
# Public address of the website. Stripe returns sellers here after payout setup
# (Stripe Connect Express must be enabled on the Stripe account), and emails link to it.
APP_URL=http://localhost:3010

# Media and notifications
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Verification providers
IMEI_CHECK_API_KEY=
IMEI_CHECK_API_URL=https://api.imeicheck.com
IFREE_ICLOUD_API_KEY=
IFREE_ICLOUD_API_URL=https://ifreeicloud.co.uk

# Royal Mail Click & Drop / Parcel API (https://api.parcel.royalmail.com/)
ROYAL_MAIL_API_URL=https://api.parcel.royalmail.com/api/v1
ROYAL_MAIL_CLICK_DROP_KEY=
